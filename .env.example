# CMI settings. Copy to .env and fill in. Never commit .env.
# Real environment variables override values here.

# REQUIRED in production: signs login sessions. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CMI_SECRET_KEY=

# Where `python app.py` listens. 0.0.0.0 = reachable from other machines; 127.0.0.1 = this machine only.
CMI_HOST=0.0.0.0
CMI_PORT=8080

# Database and attachment storage (defaults: instance/cmi.db and instance/uploads)
# CMI_DATABASE_URL=sqlite:///cmi.db
# CMI_UPLOAD_DIR=D:/CMI-data/uploads

# Only these email domains may request a sign-in code (comma separated). Empty = any domain.
CMI_ALLOWED_DOMAINS=

# Outgoing mail for sign-in codes and notifications. Leave CMI_MAIL_SERVER empty to print mail to the console.
CMI_MAIL_SERVER=
CMI_MAIL_PORT=587
CMI_MAIL_TLS=1
CMI_MAIL_USER=
CMI_MAIL_PASSWORD=
CMI_MAIL_FROM=cmi@yourcompany.com

# Set to 1 when CMI is served over HTTPS
CMI_SECURE_COOKIES=0

# Password given to demo users created by `flask --app app seed` (random if empty)
CMI_SEED_PASSWORD=
